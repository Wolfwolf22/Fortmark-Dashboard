{
  "name": "fortmark-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:auth": "node --experimental-strip-types --conditions=react-server --no-warnings scripts/test_dashboard_access.ts",
    "test": "npm run typecheck && npm run test:auth && npm run test:profile && npm run test:ai && npm run test:ai:tools && npm run test:ai:providers && npm run test:ai:actions && npm run test:mls && npm run test:transactions && npm run test:contacts && npm run test:metrics && npm run test:search",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs --force",
    "db:check": "node --experimental-strip-types --conditions=react-server --no-warnings scripts/db_check.ts",
    "test:profile": "node --experimental-strip-types --conditions=react-server --no-warnings scripts/test_profile.ts",
    "test:ai": "node --experimental-strip-types --conditions=react-server --no-warnings scripts/test_ai.ts",
    "test:mls": "node --experimental-strip-types --conditions=react-server --no-warnings scripts/test_mls.ts",
    "test:transactions": "node --experimental-strip-types --conditions=react-server --no-warnings scripts/test_transactions.ts",
    "test:contacts": "node --experimental-strip-types --conditions=react-server --no-warnings scripts/test_contacts.ts",
    "test:metrics": "node --experimental-strip-types --conditions=react-server --no-warnings scripts/test_metrics.ts",
    "test:search": "node --experimental-strip-types --conditions=react-server --no-warnings scripts/test_search.ts",
    "test:ai:tools": "node --experimental-strip-types --conditions=react-server --no-warnings scripts/test_ai_tools.ts",
    "test:ai:providers": "node --experimental-strip-types --conditions=react-server --no-warnings scripts/test_ai_providers.ts",
    "test:ai:actions": "node --experimental-strip-types --conditions=react-server --no-warnings scripts/test_ai_actions.ts",
    "certify:f2b": "playwright test --project=setup --project=certification e2e/f2b-certification.spec.ts",
    "certify:f2b:expiry": "playwright test --project=setup --project=certification e2e/expiry.spec.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@clerk/nextjs": "^7.5.21",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@vercel/blob": "^2.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.474.0",
    "next": "^15.3.0",
    "next-themes": "^0.4.4",
    "openai": "^7.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "recharts": "^2.15.1",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.36",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.3"
  }
}
