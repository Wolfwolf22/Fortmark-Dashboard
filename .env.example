# FortMark Dashboard — environment variable NAMES only. Never commit values.
#
# Scope key:
#   [dev]     Local development (.env.local)
#   [preview] Vercel Preview
#   [prod]    Vercel Production
#
# The dashboard is a zone of the FortMark portal and shares its Clerk
# instance. Preview and Production must use SEPARATE Clerk instances/keys —
# do not point Preview at the production instance.

# --- Clerk -----------------------------------------------------------------
# Publishable key is client-visible by design. [dev] [preview] [prod]
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret key is server-only. Never expose, never log. [dev] [preview] [prod]
CLERK_SECRET_KEY=

# --- Origins ---------------------------------------------------------------
# Canonical origin serving BOTH the portal and this dashboard zone.
# Production: https://app.fortmark.net
# Local:      http://localhost:3000
# Used to build absolute sign-in / sign-out URLs and as the default Clerk
# authorized party. [dev] [preview] [prod]
NEXT_PUBLIC_APP_URL=

# Path of the portal's Clerk sign-in route. Defaults to /sign-in when unset.
# Optional. [dev] [preview] [prod]
NEXT_PUBLIC_CLERK_SIGN_IN_URL=

# Extra origins Clerk may accept a session token from, compared against the
# token's `azp` claim. Comma or whitespace separated, no trailing slash.
# Production MUST list only https://app.fortmark.net — never a wildcard and
# never an arbitrary *.vercel.app origin. Vercel-generated preview URLs are
# added automatically, and only when VERCEL_ENV=preview.
# Optional. [preview] [prod]
CLERK_AUTHORIZED_PARTIES=

# --- FortMark authorization ------------------------------------------------
# Server-only allowlist of approved Clerk user IDs for the dashboard.
# Accepts a JSON array of strings or a comma/whitespace-separated list; every
# entry must look like `user_...`. A single malformed entry fails the whole
# configuration CLOSED. Max 64 entries.
#
# Never prefix this with NEXT_PUBLIC_. Never log or render it. The dashboard
# only ever compares SHA-256 digests and never returns the raw values.
#
# This is the same semantic source the MCP server uses, but it is a separate
# verification flow: an approved browser session is NOT an MCP OAuth token.
# [dev] [preview] [prod]
FORTMARK_ALLOWED_CLERK_USER_IDS=

# --- Release 1: professional profile database ------------------------------
# Neon PostgreSQL connection. Server-only — never NEXT_PUBLIC_, never logged.
# Preview and Production MUST use separate Neon branches. [dev] [preview] [prod]
DATABASE_URL=

# Feature flags. All default OFF, and OFF always means "the dashboard behaves
# exactly as it does today" — never "access denied".
# Read/write FortMark user + profile rows. [dev] [preview] [prod]
PROFILE_DATABASE_ENABLED=
# Render top-bar identity, drawer and profile editor. Requires the flag above.
PROFESSIONAL_PROFILE_UI_ENABLED=
# Permit Blob writes for profile photos. Only the exact value "1" enables it.
#
# A separate gate from the UI flag because Vercel's managed Blob connection
# scopes BLOB_READ_WRITE_TOKEN to Production AND Preview with no per-branch
# option — so token presence must never be what turns uploads on. Production
# stays 0. [preview]
PROFILE_IMAGE_UPLOAD_ENABLED=
# Managed by the Vercel Blob connection. Server-only, never NEXT_PUBLIC_.
# [preview]
# Profile-image store credential, server-only, never NEXT_PUBLIC_.
# Production REQUIRES PROFILE_BLOB_READ_WRITE_TOKEN and never falls back to
# BLOB_READ_WRITE_TOKEN: Vercel's managed connection scopes one Preview store's
# token into Production too, so the generic variable may be a preview
# credential there.
PROFILE_BLOB_READ_WRITE_TOKEN=
BLOB_READ_WRITE_TOKEN=

# Hand dashboard authorization to the database. MUST remain unset/false in
# Release 1 — lib/flags.ts additionally hard-disables it in code, so setting
# this has no effect until that guard is lifted in a later release.
DATABASE_ACCESS_CONTROL_ENABLED=
