# FortMark Dashboard — environment variable NAMES only. Never commit values.
#
# Scope key:
#   [dev]     Local development (.env.local)
#   [preview] Vercel Preview
#   [prod]    Vercel Production
#
# The dashboard is a zone of the FortMark portal and shares its Clerk
# instance. Preview and Production must use SEPARATE Clerk instances/keys —
# do not point Preview at the production instance.

# --- Clerk -----------------------------------------------------------------
# Publishable key is client-visible by design. [dev] [preview] [prod]
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret key is server-only. Never expose, never log. [dev] [preview] [prod]
CLERK_SECRET_KEY=

# --- Origins ---------------------------------------------------------------
# Canonical origin serving BOTH the portal and this dashboard zone.
# Production: https://app.fortmark.net
# Local:      http://localhost:3000
# Used to build absolute sign-in / sign-out URLs and as the default Clerk
# authorized party. [dev] [preview] [prod]
NEXT_PUBLIC_APP_URL=

# Path of the portal's Clerk sign-in route. Defaults to /sign-in when unset.
# Optional. [dev] [preview] [prod]
NEXT_PUBLIC_CLERK_SIGN_IN_URL=

# Extra origins Clerk may accept a session token from, compared against the
# token's `azp` claim. Comma or whitespace separated, no trailing slash.
# Production MUST list only https://app.fortmark.net — never a wildcard and
# never an arbitrary *.vercel.app origin. Vercel-generated preview URLs are
# added automatically, and only when VERCEL_ENV=preview.
# Optional. [preview] [prod]
CLERK_AUTHORIZED_PARTIES=

# --- FortMark authorization ------------------------------------------------
# Server-only allowlist of approved Clerk user IDs for the dashboard.
# Accepts a JSON array of strings or a comma/whitespace-separated list; every
# entry must look like `user_...`. A single malformed entry fails the whole
# configuration CLOSED. Max 64 entries.
#
# Never prefix this with NEXT_PUBLIC_. Never log or render it. The dashboard
# only ever compares SHA-256 digests and never returns the raw values.
#
# This is the same semantic source the MCP server uses, but it is a separate
# verification flow: an approved browser session is NOT an MCP OAuth token.
# [dev] [preview] [prod]
FORTMARK_ALLOWED_CLERK_USER_IDS=

# --- Release 1: professional profile database ------------------------------
# Neon PostgreSQL connection. Server-only — never NEXT_PUBLIC_, never logged.
# Preview and Production MUST use separate Neon branches. [dev] [preview] [prod]
DATABASE_URL=

# Feature flags. All default OFF, and OFF always means "the dashboard behaves
# exactly as it does today" — never "access denied".
# Read/write FortMark user + profile rows. [dev] [preview] [prod]
PROFILE_DATABASE_ENABLED=
# Render top-bar identity, drawer and profile editor. Requires the flag above.
PROFESSIONAL_PROFILE_UI_ENABLED=
# Permit Blob writes for profile photos. Only the exact value "1" enables it.
#
# A separate gate from the UI flag because Vercel's managed Blob connection
# scopes BLOB_READ_WRITE_TOKEN to Production AND Preview with no per-branch
# option — so token presence must never be what turns uploads on. Production
# stays 0. [preview]
PROFILE_IMAGE_UPLOAD_ENABLED=
# Managed by the Vercel Blob connection. Server-only, never NEXT_PUBLIC_.
# [preview]
# Profile-image store credential, server-only, never NEXT_PUBLIC_.
# Production REQUIRES PROFILE_BLOB_READ_WRITE_TOKEN and never falls back to
# BLOB_READ_WRITE_TOKEN: Vercel's managed connection scopes one Preview store's
# token into Production too, so the generic variable may be a preview
# credential there.
PROFILE_BLOB_READ_WRITE_TOKEN=
BLOB_READ_WRITE_TOKEN=

# --- Release C: transactions ------------------------------------------------
# Read/write brokerage transactions in the database (migration 0005). Requires
# PROFILE_DATABASE_ENABLED — deals are owned by dashboard_users rows. Off means
# the transactions screen keeps the labelled sample set. [dev] [preview] [prod]
TRANSACTIONS_DATABASE_ENABLED=

# --- Release D: contacts ----------------------------------------------------
# Read/write brokerage contacts — leads, clients, past clients — in the
# database (migration 0006). Requires PROFILE_DATABASE_ENABLED. Off means the
# leads screen keeps the labelled sample set. [dev] [preview] [prod]
CONTACTS_DATABASE_ENABLED=

# --- Release E: home metrics -------------------------------------------------
# Show the GENERATED sample brokerage on Home instead of reporting a domain as
# not connected. Strict: only "1". Off (the default) means Home shows only
# numbers it can prove, and says "not connected" for the rest. Never set this
# in an environment where anyone might read the dashboard as fact. [dev]
SAMPLE_DASHBOARD_ENABLED=

# Show GENERATED listings — invented addresses, prices and photographs —
# instead of reporting the MLS as not connected. Strict: only "1". Off (the
# default) means a deployment with no Bridge credential says it has no
# listings, rather than making some up. This used not to exist, and its
# absence meant every unconfigured deployment showed invented properties
# through the real screens. Never set it where anyone might read a listing as
# fact. [dev]
SAMPLE_LISTINGS_ENABLED=

# Hand dashboard authorization to the database. MUST remain unset/false in
# Release 1 — lib/flags.ts additionally hard-disables it in code, so setting
# this has no effect until that guard is lifted in a later release.
DATABASE_ACCESS_CONTROL_ENABLED=

# --- Assistant provider ----------------------------------------------------
#
# Permit calls to the paid model provider. A SEPARATE gate from key presence,
# for the same reason the Blob upload flag is separate from its token: a
# credential can arrive in an environment for another purpose, and if presence
# were the switch, adding it would start billed traffic in every scope at once
# without anyone choosing to.
#
# Strict — only the exact string "1". "true", "yes" and "on" are all rejected,
# because this flag authorises spending against an external account and a typo
# should fail closed rather than be guessed generously.
#
# Unset (or anything but "1") means the assistant answers nothing and says so.
# There is no generated reply behind it and no other mode.
AI_CHAT_PROVIDER_ENABLED=

# Which vendor does the reasoning: "anthropic" or "openai". Unset means
# anthropic, which is what this deployment did before a second vendor was
# supported. Any other value is refused outright — the assistant is
# unavailable rather than served by a guess. FortMark's tools, authorization,
# DTOs and limits are identical either way; see docs/AI_PROVIDERS.md.
AI_PROVIDER=

# The model, overriding the selected vendor's default (claude-opus-5 for
# anthropic, gpt-5.5 for openai). Server-side only: the browser never chooses
# a model, because a caller-chosen model is a caller-chosen bill.
AI_MODEL=

# The selected vendor's API key. ONLY the selected one is required, and only
# the selected one is ever read: with AI_PROVIDER=anthropic and no Anthropic
# key, the assistant is unavailable — it does NOT quietly answer with OpenAI,
# and the reverse is equally forbidden.
#
# Server-only, never NEXT_PUBLIC_ — both are read in
# lib/ai/providers/select.ts, which is import-guarded by "server-only".
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- MLS listings ------------------------------------------------------------
#
# Switch the listings screen from the built-in sample set to the brokerage's
# MLS. Strict — only the exact string "1". Off (or anything else) means the
# sample generators, plainly labelled "Sample data" on the screen.
#
# A SEPARATE gate from credential presence: a credential can be present in an
# environment for another purpose, and presence as the switch would change the
# source without anyone choosing to. [preview] [prod]
MLS_LISTINGS_ENABLED=
# Bridge Interactive (RESO Web API) credential and dataset code — the same
# dataset the FortMark MCP server reads. Server-only, never NEXT_PUBLIC_, never
# logged. Both are required when the flag above is on; with the flag on and
# either missing, listings answer 503 rather than falling back to sample rows.
# The token travels only in the Authorization header, never in a URL.
BRIDGE_API_TOKEN=
BRIDGE_DATASET=
# Optional base URL override (tests point this at a local stub). Defaults to
# https://api.bridgedataoutput.com/api/v2/OData
BRIDGE_BASE_URL=
